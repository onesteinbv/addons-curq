<?xml version="1.0" encoding="utf-8" ?>
<data>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//div[@id='companies']/block[@name='companies_setting_container']"
                position='inside'
            >
                <setting
                    string="Default Company Watermark"
                    id="outgoing_report_settings"
                >
                    <field
                        name="outgoing_report_config_ids"
                        widget="many2many_tags"
                        help="Configure the reports that should use the default
                               company logo when a report-specific logo is not configured."
                        options="{'no_create':True}"
                    />
                    <div
                        class="text-muted"
                        id="outgoing_report_config_explanation"
                    >Configure the reports that should use the default
                        company logo when a report-specific logo is not configured.
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</data>
