<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <function model="res.config.settings" name="create">
        <value
            model="res.config.settings"
            eval="dict(
            obj().default_get(list(obj().fields_get())),
            **{
                'outgoing_report_config_ids': [
                    (4, obj().env.ref('sale_timesheet.timesheet_report_sale_order').id),
                    (4, obj().env.ref('sale_timesheet.timesheet_report_account_move').id),
                ],
            })"
        />
        <value name="context" eval="{'watermark_append_mode': True}" />
    </function>
</odoo>
