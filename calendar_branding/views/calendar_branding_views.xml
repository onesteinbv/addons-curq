<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_calendar_event_form_inherit" model="ir.ui.view">
        <field name="name">calendar.event.form.inherit.branding</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form" />
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <xpath
                expr="//button[@name='set_discuss_videocall_location']/span[not(hasclass('fa'))]"
                position="replace"
            >
                <span> CURQ Meeting</span>
            </xpath>
        </field>
    </record>
    <record id="view_calendar_event_form_quick_create_inherit" model="ir.ui.view">
        <field name="name">calendar.event.form.quick_create.inherit.branding</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form_quick_create" />
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <xpath
                expr="//button[@name='set_discuss_videocall_location']/span[not(hasclass('fa'))]"
                position="replace"
            >
                <span>CURQ Meeting</span>
            </xpath>
        </field>
    </record>
</odoo>
