<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="role_administrator" model="res.users.role">
        <field name="name">Administrator</field>
        <field name="comment">Full access to all features and settings of CURQ.</field>
        <field
            name="implied_by_text"
            type="char"
            file="container_accessibility/security/administrator/groups"
        />
    </record>

    <record id="role_manager" model="res.users.role">
        <field name="name">Manager</field>
        <field
            name="comment"
        >Access to management features and settings of CURQ.</field>
        <field
            name="implied_by_text"
            type="char"
            file="container_accessibility/security/manager/groups"
        />
    </record>

    <record id="role_user" model="res.users.role">
        <field name="name">User</field>
        <field name="comment">Access to their own documents.</field>
        <field
            name="implied_by_text"
            type="char"
            file="container_accessibility/security/user/groups"
        />
    </record>

    <record id="role_accountant" model="res.users.role">
        <field name="name">Accountant</field>
        <field name="comment">Access to accounting features.</field>
        <field
            name="implied_by_text"
            type="char"
            file="container_accessibility/security/accountant/groups"
        />
    </record>

    <record id="role_guest" model="res.users.role">
        <field name="name">Guest</field>
        <field name="comment">Only access to the portal.</field>
        <field
            name="implied_by_text"
            type="char"
            file="container_accessibility/security/guest/groups"
        />
    </record>
</odoo>
