<odoo>
    <record id="rule_restricted_users_admin_read" model="ir.rule">
        <field name="name">rule_restricted_users admin read</field>
        <field name="model_id" ref="base.model_res_users" />
        <field
            name="groups"
            eval="[(4, ref('container_accessibility.group_administrator'))]"
        />
        <field
            name="domain_force"
            eval="['|', ('role_id', 'in', [
                ref('container_accessibility.role_administrator'),
                ref('container_accessibility.role_manager'),
                ref('container_accessibility.role_user'),
                ref('container_accessibility.role_accountant'),
                ref('container_accessibility.role_guest')
            ]), ('id', '=', ref('base.default_user'))]"
        />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="0" />
        <field name="perm_write" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>
