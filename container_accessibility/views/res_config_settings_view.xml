<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <!-- Remove debug mode tool -->
            <xpath expr="//widget[@name='res_config_dev_tool']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Remove 'Edit Layout' button -->
            <xpath expr="//button[@name='edit_external_header']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//setting[@id='document_layout_setting']//br[1]"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="mail_res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <!-- Remove 'Update Mail Layout' button -->
            <xpath expr="//button[@name='open_email_layout']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Remove 'Review All Templates' button -->
            <xpath expr="//button[@name='open_mail_templates']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
